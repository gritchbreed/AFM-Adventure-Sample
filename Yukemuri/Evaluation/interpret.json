{
  "note": "入力の解釈の評価。発言は台本の発言例と言い方を変えて書く（同じ言い方では、数字が甘くなる）",
  "setups": {
    "shop": {"inputs": ["なし"], "scene": "S1"},
    "back": {"inputs": ["なし", "移動:控え室"], "scene": "S2"}
  },
  "cases": [
    {"id": "shop-01", "setup": "shop", "category": "赤いドア", "text": "入口のドア、ちょっと重たいよね", "expect": ["意図:赤いドア"]},
    {"id": "shop-02", "setup": "shop", "category": "赤いドア", "text": "中が見えないと、初めての人は入りにくいかも", "expect": ["意図:赤いドア"]},
    {"id": "shop-03", "setup": "shop", "category": "赤いドア", "text": "吉永としては、ドアはそのままでいいと思うな", "expect": ["意図:赤いドア"], "note": "主人公の名前を含む"},
    {"id": "shop-04", "setup": "shop", "category": "店名と看板", "text": "血の池って名前、インパクトあるよね", "expect": ["意図:店名と看板"]},
    {"id": "shop-05", "setup": "shop", "category": "店名と看板", "text": "看板をもっと明るくしたら？", "expect": ["意図:店名と看板"]},
    {"id": "shop-06", "setup": "shop", "category": "音楽", "text": "BGMを今どきの曲にするとか", "expect": ["意図:音楽"]},
    {"id": "shop-07", "setup": "shop", "category": "音楽", "text": "カラオケの機械を新しくしたら、若い人も来るんじゃない", "expect": ["意図:音楽"]},
    {"id": "shop-08", "setup": "shop", "category": "メニュー", "text": "名物のつまみがあるといいかも", "expect": ["意図:メニュー"]},
    {"id": "shop-09", "setup": "shop", "category": "メニュー", "text": "甘いカクテルを置いてみたら？", "expect": ["意図:メニュー"]},
    {"id": "shop-10", "setup": "shop", "category": "メニュー", "text": "酔い覚ましにコーヒーも出せばいいのに", "expect": ["意図:メニュー"]},
    {"id": "shop-11", "setup": "shop", "category": "宣伝の写真", "text": "インスタに載せたら若い子が来るよ", "expect": ["意図:宣伝の写真"]},
    {"id": "shop-12", "setup": "shop", "category": "宣伝の写真", "text": "お店の写真を撮ってネットに出そうよ", "expect": ["意図:宣伝の写真"]},
    {"id": "shop-13", "setup": "shop", "category": "いい店とは", "text": "一人でもふらっと入れる店がいいんじゃないかな", "expect": ["意図:いい店とは"]},
    {"id": "shop-14", "setup": "shop", "category": "いい店とは", "text": "にぎやかすぎる店って疲れない？", "expect": ["意図:いい店とは"]},
    {"id": "shop-15", "setup": "shop", "category": "いい店とは", "text": "結局、居心地がいいのが一番だよ", "expect": ["意図:いい店とは"]},
    {"id": "shop-16", "setup": "shop", "category": "今のままでいい", "text": "変えなくていいよ、この店は", "expect": ["意図:今のままでいい"]},
    {"id": "shop-17", "setup": "shop", "category": "今のままでいい", "text": "このままの血の池が好きだな", "expect": ["意図:今のままでいい", "意図:店名と看板"]},
    {"id": "shop-18", "setup": "shop", "category": "二人の先の話", "text": "結婚とか、考えてる？", "expect": ["意図:二人の先の話"]},
    {"id": "shop-19", "setup": "shop", "category": "二人の先の話", "text": "前に渡したプレゼント、返してくれる？", "expect": ["意図:二人の先の話"]},
    {"id": "shop-20", "setup": "shop", "category": "移動", "text": "ちょっと控室に行ってくるね", "expect": ["移動:控え室"]},
    {"id": "shop-21", "setup": "shop", "category": "移動", "text": "葵、奥で話そう。行こう", "expect": ["移動:控え室"]},
    {"id": "shop-22", "setup": "shop", "category": "なし", "text": "ママ、今日もきれいだね", "expect": ["なし"]},
    {"id": "shop-23", "setup": "shop", "category": "なし", "text": "お腹いっぱいだよ", "expect": ["なし"]},
    {"id": "shop-24", "setup": "shop", "category": "なし", "text": "葵、さっきのパスタおいしかったね", "expect": ["なし"]},
    {"id": "shop-25", "setup": "shop", "category": "なし", "text": "吉永さんって呼ばれるの、ちょっと照れるな", "expect": ["なし"], "note": "主人公の名前を含む"},
    {"id": "shop-26", "setup": "shop", "category": "なし", "text": "そのグラス、ぴかぴかに磨いてるね", "expect": ["なし"]},

    {"id": "back-01", "setup": "back", "category": "赤いドア", "text": "あのドア、実は好きなんでしょ", "expect": ["意図:赤いドア"]},
    {"id": "back-02", "setup": "back", "category": "音楽", "text": "葵の好きな映画の曲、店で流してみたら？", "expect": ["意図:音楽"]},
    {"id": "back-03", "setup": "back", "category": "メニュー", "text": "コーヒー、出したいんでしょ", "expect": ["意図:メニュー"]},
    {"id": "back-04", "setup": "back", "category": "いい店とは", "text": "葵の好きな店って、どんなの？", "expect": ["意図:いい店とは"]},
    {"id": "back-05", "setup": "back", "category": "宣伝の写真", "text": "写真を撮るなら、何がいいと思う？", "expect": ["意図:宣伝の写真"]},
    {"id": "back-06", "setup": "back", "category": "今のままでいい", "text": "本当は、このままでいいって思ってる？", "expect": ["意図:今のままでいい"]},
    {"id": "back-07", "setup": "back", "category": "二人の先の話", "text": "将来のこと、ちゃんと話そうか", "expect": ["意図:二人の先の話"]},
    {"id": "back-08", "setup": "back", "category": "移動", "text": "店に戻ろうか", "expect": ["移動:店内"]},
    {"id": "back-09", "setup": "back", "category": "移動", "text": "ママのところに戻ろう", "expect": ["移動:店内"]},
    {"id": "back-10", "setup": "back", "category": "移動", "text": "そろそろママに会いに行こう", "expect": ["移動:店内"]},
    {"id": "back-11", "setup": "back", "category": "なし", "text": "ノアは元気にしてる？", "expect": ["なし"]},
    {"id": "back-12", "setup": "back", "category": "なし", "text": "疲れてない？", "expect": ["なし"]},
    {"id": "back-13", "setup": "back", "category": "なし", "text": "このポスター、古いね", "expect": ["なし"]}
  ]
}
